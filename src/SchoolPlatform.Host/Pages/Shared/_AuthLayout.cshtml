@inject IOptions<InstitutionOptions> Institution
<!DOCTYPE html>
<html lang="@Institution.Value.Locale.Culture">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] · @Institution.Value.DisplayName</title>
  <link rel="icon" href="@Institution.Value.Assets.Favicon" />
  <link rel="stylesheet" href="/branding/theme.css" />
  <link rel="stylesheet" href="/auth.css" />
</head>
<body>
  <a class="skip-link" href="#main">Saltar al contenido</a>
  <main id="main" class="auth-shell">
    <section class="brand-panel" aria-label="Institución">
      <a href="/" class="brand"><img src="@Institution.Value.Assets.MainLogo" alt="" /><span>@(string.IsNullOrWhiteSpace(Institution.Value.Public.HeroTitle) ? Institution.Value.DisplayName : Institution.Value.Public.HeroTitle)<small>@Institution.Value.CampusLabel</small></span></a>
      <div class="brand-message"><div class="eyebrow">COMUNIDAD EDUCATIVA</div><h1>@Institution.Value.Tagline</h1><p>@Institution.Value.WelcomeMessage</p></div>
      <p class="brand-footer">@Institution.Value.DisplayName</p>
      @if (!string.IsNullOrWhiteSpace(Institution.Value.Assets.HeroImage)) { <img class="auth-campus" src="@Institution.Value.Assets.HeroImage" alt="" /> }
    </section>
    <section class="form-panel">@RenderBody()</section>
  </main>
</body>
</html>
